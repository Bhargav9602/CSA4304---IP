<!DOCTYPE html>
<html>
<head>
    <title>Fashion E-Commerce Website</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f7f7f7;
        }

        header {
            background-color: #111;
            color: white;
            text-align: center;
            padding: 25px;
        }

        nav {
            background-color: #222;
            text-align: center;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 20px;
            font-size: 17px;
        }

        nav a:hover {
            color: #f1c40f;
        }

        .container {
            width: 85%;
            margin: 30px auto;
        }

        .box {
            background-color: white;
            padding: 25px;
            margin-bottom: 25px;
            border-radius: 8px;
        }

        h2 {
            color: #222;
        }

        .products {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .product {
            width: 28%;
            background-color: #f2f2f2;
            padding: 20px;
            text-align: center;
            border-radius: 8px;
        }

        .product h3 {
            color: #333;
        }

        .price {
            color: #e74c3c;
            font-size: 20px;
            font-weight: bold;
        }

        button {
            background-color: #111;
            color: white;
            border: none;
            padding: 10px 20px;
            cursor: pointer;
            border-radius: 4px;
        }

        button:hover {
            background-color: #e74c3c;
        }

        label {
            font-weight: bold;
        }

        input, select, textarea {
            width: 90%;
            padding: 10px;
            margin: 8px 0 15px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        textarea {
            height: 80px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 12px;
            text-align: center;
        }

        th {
            background-color: #111;
            color: white;
        }

        footer {
            background-color: #111;
            color: white;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>

<body>

<header>
    <h1>FASHION HUB</h1>
    <p>Style • Trend • Confidence</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#products">Products</a>
    <a href="#categories">Categories</a>
    <a href="#order">Order</a>
    <a href="#contact">Contact</a>
</nav>

<div class="container">

    <!-- Home -->
    <section id="home" class="box">
        <h2>Welcome to Fashion Hub</h2>
        <p>
            Discover the latest fashion trends for men, women and kids.
            Shop stylish clothes, footwear and accessories at affordable prices.
        </p>
    </section>

    <!-- Categories -->
    <section id="categories" class="box">
        <h2>Fashion Categories</h2>

        <ul>
            <li>Men's Fashion</li>
            <li>Women's Fashion</li>
            <li>Kids Fashion</li>
            <li>Footwear</li>
            <li>Watches</li>
            <li>Accessories</li>
        </ul>
    </section>

    <!-- Products -->
    <section id="products" class="box">
        <h2>Featured Products</h2>

        <div class="products">

            <div class="product">
                <h3>Men's T-Shirt</h3>
                <p>Cotton Casual T-Shirt</p>
                <p class="price">₹799</p>
                <button>Add to Cart</button>
            </div>

            <div class="product">
                <h3>Women's Dress</h3>
                <p>Stylish Party Dress</p>
                <p class="price">₹1,499</p>
                <button>Add to Cart</button>
            </div>

            <div class="product">
                <h3>Running Shoes</h3>
                <p>Comfortable Sports Shoes</p>
                <p class="price">₹1,999</p>
                <button>Add to Cart</button>
            </div>

            <div class="product">
                <h3>Denim Jeans</h3>
                <p>Classic Blue Jeans</p>
                <p class="price">₹1,299</p>
                <button>Add to Cart</button>
            </div>

            <div class="product">
                <h3>Handbag</h3>
                <p>Trendy Women's Handbag</p>
                <p class="price">₹999</p>
                <button>Add to Cart</button>
            </div>

            <div class="product">
                <h3>Smart Watch</h3>
                <p>Fashionable Digital Watch</p>
                <p class="price">₹2,499</p>
                <button>Add to Cart</button>
            </div>

        </div>
    </section>

    <!-- Order -->
    <section id="order" class="box">
        <h2>Place Your Order</h2>

        <form>

            <label>Customer Name:</label><br>
            <input type="text" placeholder="Enter your name"><br>

            <label>Email:</label><br>
            <input type="email" placeholder="Enter email"><br>

            <label>Phone Number:</label><br>
            <input type="tel" placeholder="Enter phone number"><br>

            <label>Select Product:</label><br>
            <select>
                <option>Select Product</option>
                <option>Men's T-Shirt</option>
                <option>Women's Dress</option>
                <option>Running Shoes</option>
                <option>Denim Jeans</option>
                <option>Handbag</option>
                <option>Smart Watch</option>
            </select><br>

            <label>Size:</label><br>
            <select>
                <option>Select Size</option>
                <option>Small</option>
                <option>Medium</option>
                <option>Large</option>
                <option>XL</option>
                <option>XXL</option>
            </select><br>

            <label>Quantity:</label><br>
            <input type="number" min="1" value="1"><br>

            <label>Payment Method:</label><br>
            <select>
                <option>Cash on Delivery</option>
                <option>UPI</option>
                <option>Debit Card</option>
                <option>Credit Card</option>
            </select><br>

            <label>Delivery Address:</label><br>
            <textarea placeholder="Enter delivery address"></textarea><br>

            <button type="submit">Place Order</button>

        </form>
    </section>

    <!-- Offers -->
    <section class="box">
        <h2>Special Offers</h2>

        <table>
            <tr>
                <th>Offer</th>
                <th>Discount</th>
                <th>Validity</th>
            </tr>

            <tr>
                <td>Men's Fashion</td>
                <td>20% OFF</td>
                <td>Limited Time</td>
            </tr>

            <tr>
                <td>Women's Fashion</td>
                <td>30% OFF</td>
                <td>Limited Time</td>
            </tr>

            <tr>
                <td>Footwear</td>
                <td>15% OFF</td>
                <td>Limited Time</td>
            </tr>
        </table>
    </section>

</div>

<footer id="contact">
    <h3>Fashion Hub</h3>
    <p>Email: fashionhub@example.com</p>
    <p>Phone: 9876543210</p>
    <p>Fashion E-Commerce Website © 2026</p>
</footer>

</body>
</html>
